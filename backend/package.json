{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env ./bin/www",
    "dev": "node --watch --env-file-if-exists=.env ./bin/www",
    "db:migrate": "node --env-file-if-exists=.env ./db/migrate-cli.js",
    "user:create": "node --env-file-if-exists=.env ./bin/provision-user",
    "test": "node --test --test-concurrency=1 test/*.test.js test/*.test.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "ejs": "~2.6.1",
    "exceljs": "4.4.0",
    "express": "~4.16.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
