# Copy file này thành .env rồi chỉnh giá trị cho môi trường local.
# .env đã nằm trong .gitignore, không commit.

# Express server
NODE_ENV=development
PORT=3000

# PostgreSQL (khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_management
DB_USER=asset_app
DB_PASSWORD=asset_app_dev
DB_POOL_MAX=10

# Browser origins accepted for sign-in, credentialed CORS and unsafe requests.
# Use exact origins only (no paths, trailing slash or wildcard).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Replace with a cryptographically random value of at least 32 characters in
# every deployed environment. The local default is intentionally rejected when
# NODE_ENV=production.
CSRF_SECRET=local-development-csrf-secret-change-before-production

# Local HTTP uses asset_session. Production always uses the Secure,
# host-only __Host-asset_session cookie and requires COOKIE_SECURE=true.
COOKIE_SECURE=false
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_TOUCH_INTERVAL_SECONDS=60

# Expired/revoked sessions are purged at startup and on this interval.
SESSION_RETENTION_SECONDS=604800
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Argon2id password hashing. Production validation enforces the safe minima.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32

# In-process request limits. Sign-in counts failed responses only and returns
# RATE_LIMITED with Retry-After. Use a shared store before horizontal scaling.
SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=900
SIGN_IN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=1000

# After AUTH_LOCKOUT_MAX_FAILURES failed sign-ins for the same account within
# AUTH_LOCKOUT_WINDOW_SECONDS, the account is locked for AUTH_LOCKOUT_SECONDS.
AUTH_LOCKOUT_MAX_FAILURES=10
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
