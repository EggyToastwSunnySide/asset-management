#!/usr/bin/env node

var app = require('../app');
var config = require('../config');
var db = require('../db/pool');
var debug = require('debug')('backend:server');
var http = require('http');
var runMigrations = require('../db/migrate').runMigrations;
var purgeStaleSessions = require('../repositories/auth.repo').purgeStaleSessions;

var port = normalizePort(config.port);
app.set('port', port);

var server = http.createServer(app);
server.on('error', onError);
server.on('listening', onListening);

var sessionCleanupTimer = null;

function cleanupSessions() {
  return purgeStaleSessions(config.auth.session.retentionSeconds).catch(function (err) {
    console.error('Session cleanup failed:', err.message);
  });
}

async function start() {
  await runMigrations(config.db);
  await db.query('SELECT 1');
  await cleanupSessions();
  sessionCleanupTimer = setInterval(cleanupSessions, config.auth.session.cleanupIntervalSeconds * 1000);
  sessionCleanupTimer.unref();
  server.listen(port);
}

async function shutdown(signal) {
  debug('Received ' + signal + ', shutting down');
  if (sessionCleanupTimer) clearInterval(sessionCleanupTimer);
  server.close(async function () {
    await db.pool.end().catch(function () {});
    process.exit(0);
  });
}

process.once('SIGTERM', function () { shutdown('SIGTERM'); });
process.once('SIGINT', function () { shutdown('SIGINT'); });

start().catch(async function (err) {
  console.error('Backend startup failed:', err.message);
  await db.pool.end().catch(function () {});
  process.exit(1);
});

function normalizePort(val) {
  var parsed = parseInt(val, 10);
  if (isNaN(parsed)) return val;
  if (parsed >= 0) return parsed;
  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;
  var bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
